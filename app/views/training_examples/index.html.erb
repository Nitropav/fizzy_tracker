<% @page_title = "Training Examples" %>

<% content_for :header do %>
  <div class="header__actions header__actions--start">
    <%= back_link_to "Cactus Home", cactus_home_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
  </div>
<% end %>

<section class="panel panel--wide center flex flex-column gap">
  <header class="flex align-center justify-between flex-wrap gap">
    <div class="min-width">
      <h1 class="txt-x-large font-weight-black margin-none">Training Examples</h1>
      <p class="txt-small txt-subtle margin-none">Review generated bug-resolution snapshots before they enter the training corpus.</p>
    </div>

    <nav class="flex flex-wrap gap-half txt-small" aria-label="Training example filters">
      <%= link_to "All", training_examples_path, class: "btn" %>
      <% TrainingExample::STATUSES.each do |status| %>
        <%= link_to status.humanize, training_examples_path(status: status), class: "btn" %>
      <% end %>
      <%= link_to "Export history", training_example_exports_path, class: "btn" %>
      <% if @approved_export_count.positive? %>
        <%= button_to "Export #{@approved_export_count} approved JSONL", export_training_examples_path, class: "btn btn--reversed" %>
      <% else %>
        <span class="btn" aria-disabled="true">No approved examples to export</span>
      <% end %>
    </nav>
  </header>

  <section class="grid gap" style="grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));">
    <article class="panel border flex flex-column gap-half">
      <span class="txt-small txt-subtle">Approved for export</span>
      <strong class="txt-large"><%= @approved_export_count %></strong>
    </article>

    <article class="panel border flex flex-column gap-half">
      <span class="txt-small txt-subtle">Recent exports</span>
      <% if @latest_training_example_exports.any? %>
        <ul class="list-unindented margin-none txt-small">
          <% @latest_training_example_exports.each do |training_example_export| %>
            <li>
              <%= link_to training_example_export.filename, training_example_export_path(training_example_export), class: "txt-link" %>
              &middot; <%= pluralize(training_example_export.example_count, "example") %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <% if @exported_without_batch_count.positive? %>
          <span class="txt-small txt-subtle">
            <%= pluralize(@exported_without_batch_count, "exported example") %> predate export history.
          </span>
        <% else %>
          <span class="txt-small txt-subtle">No export batches yet.</span>
        <% end %>
      <% end %>
    </article>
  </section>

  <% if @training_examples.any? %>
    <%= with_manual_pagination :training_examples, @page do %>
      <div class="overflow-auto">
        <table class="full-width">
          <thead>
            <tr>
              <th class="txt-align-start">Issue</th>
              <th class="txt-align-start">Status</th>
              <th class="txt-align-start">Priority</th>
              <th class="txt-align-start">Domain</th>
              <th class="txt-align-start">Severity</th>
              <th class="txt-align-start">Reviewed by</th>
              <th class="txt-align-start">Created</th>
            </tr>
          </thead>
          <tbody>
            <% @training_examples.each do |training_example| %>
              <tr>
                <td>
                  <%= link_to "##{training_example.card.number} #{training_example.card.title}", training_example, class: "txt-link" %>
                </td>
                <td><%= training_example.status.humanize %></td>
                <td><%= training_example.metadata["priority"].presence&.humanize || "N/A" %></td>
                <td><%= training_example.metadata["domain"].presence || "N/A" %></td>
                <td><%= training_example.metadata["severity"].presence || "N/A" %></td>
                <td><%= training_example.reviewed_by&.name || "N/A" %></td>
                <td><%= local_datetime_tag training_example.created_at, style: :shortdate %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% else %>
    <p class="txt-subtle margin-none">No training examples found.</p>
  <% end %>
</section>
