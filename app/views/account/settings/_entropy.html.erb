<section class="settings__section">
  <header>
    <h2 class="divider">Auto close</h2>
    <div>Cactus can move stale issues to "Not Now" if there is no activity for a specific period of time. <em>This is the default global setting; you can override it on each project.</em></div>
  </header>

  <%= render "entropy/auto_close", model: account.entropy, url: account_entropy_path, disabled: !Current.user.admin? %>
</section>
