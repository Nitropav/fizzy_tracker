<div class="board-tools card">
  <%= link_to new_board_bug_report_path(board), class: "btn btn--link",
        data: { controller: "hotkey", action: "keydown.c@document->hotkey#click", turbo_frame: "_top", bridge__buttons_target: "button", bridge_title: "New issue", bridge_display_as_primary_action: true, bridge_display_title: true, bridge_icon_url: bridge_icon("add") } do %>
    <%= icon_tag "add", class: "show-on-touch" %>
    <span>New issue</span>
    <kbd class="hide-on-touch">C</kbd>
  <% end %>

  <footer <%= "hidden" unless Current.user.cactus_admin? %>>
    <%= access_involvement_advance_button(board, Current.user, show_watchers: true) %>
  </footer>
</div>
