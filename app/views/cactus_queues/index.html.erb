<% @page_title = "Cactus Queue" %>

<% content_for :header do %>
  <div class="header__actions header__actions--start">
    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
  </div>
<% end %>

<section class="panel panel--wide center flex flex-column gap">
  <header class="flex align-center justify-between gap">
    <div>
      <h1 class="txt-x-large font-weight-black margin-none">Cactus Queue</h1>
      <p class="txt-small txt-subtle margin-none">Workflow queues derived from Gate 1, Gate 2, triage, close, and training review state.</p>
    </div>
  </header>

  <nav class="flex gap-half txt-small flex-wrap" aria-label="Cactus workflow filters">
    <%= link_to "All", cactus_queues_path, class: "btn" %>
    <% Cards::CactusWorkflowQuery::STATES.each do |state| %>
      <%= link_to state.humanize, cactus_queues_path(state: state), class: "btn" %>
    <% end %>
  </nav>

  <% if @cards.any? %>
    <div class="overflow-auto">
      <table class="full-width">
        <thead>
          <tr>
            <th class="txt-align-start">Card</th>
            <th class="txt-align-start">State</th>
            <th class="txt-align-start">Board</th>
            <th class="txt-align-start">Column</th>
            <th class="txt-align-start">Gate 1</th>
            <th class="txt-align-start">Gate 2</th>
            <th class="txt-align-start">Next action</th>
            <th class="txt-align-start">Updated</th>
          </tr>
        </thead>
        <tbody>
          <% @cards.each do |card| %>
            <tr>
              <td><%= link_to "##{card.number} #{card.title}", card, class: "txt-link" %></td>
              <td><%= card.cactus_workflow_state_label %></td>
              <td><%= card.board.name %></td>
              <td><%= card.column&.name || "N/A" %></td>
              <td><%= card.resolution_record&.gate_one_status&.humanize || "N/A" %></td>
              <td><%= card.resolution_record&.gate_two_status&.humanize || "N/A" %></td>
              <td>
                <% case card.cactus_workflow_state %>
                <% when "needs_info" %>
                  <% guidance = CardResolutionRecords::GateOneGuidance.new(card) %>
                  <% if (next_item = guidance.next_item) %>
                    <div class="flex flex-column gap-half txt-small">
                      <span><strong>Ask:</strong> <%= next_item.label %></span>
                      <span class="txt-subtle"><%= next_item.prompt %></span>
                      <%= link_to "Open card", card, class: "btn txt-small" %>
                    </div>
                  <% else %>
                    <%= link_to "Review card", card, class: "btn txt-small" %>
                  <% end %>
                <% when "open" %>
                  <% columns = card.board.columns.sorted %>
                  <% if columns.any? %>
                    <%= form_with url: card_triage_path(card), method: :post, class: "flex align-center gap-half" do |form| %>
                      <%= form.select :column_id, options_from_collection_for_select(columns, :id, :name), { prompt: "Move to column..." }, class: "input txt-small" %>
                      <%= form.submit "Triage", class: "btn txt-small" %>
                    <% end %>
                  <% else %>
                    <span class="txt-small txt-subtle">No board columns</span>
                  <% end %>
                <% when "in_progress" %>
                  <% missing_gate_two = card.resolution_record&.missing_gate_two_fields || [] %>
                  <div class="flex flex-column gap-half txt-small">
                    <% if missing_gate_two.any? %>
                      <span><strong>Complete Gate 2:</strong> <%= missing_gate_two.map { it.to_s.humanize.downcase }.to_sentence %></span>
                    <% else %>
                      <span><strong>Review Gate 2 details</strong></span>
                    <% end %>
                    <%= link_to "Fill resolution", card_path(card, anchor: dom_id(card, :resolution_record)), class: "btn txt-small" %>
                  </div>
                <% when "needs_review" %>
                  <div class="flex align-center gap-half">
                    <%= link_to "Review resolution", card_path(card, anchor: dom_id(card, :resolution_record)), class: "btn txt-small" %>
                    <%= button_to "Mark resolved", card_resolution_path(card), class: "btn btn--reversed txt-small" %>
                  </div>
                <% else %>
                  <%= link_to "Open card", card, class: "btn txt-small" %>
                <% end %>
              </td>
              <td><%= local_datetime_tag card.updated_at, style: :shortdate %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="txt-subtle margin-none">No cards in this queue.</p>
  <% end %>
</section>
