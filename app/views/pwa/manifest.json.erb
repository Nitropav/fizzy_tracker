{
  "name": <%= [ "Cactus Bug Tracker", Rails.env.production? ? nil : Rails.env ].compact.join(" - ").to_json.html_safe %>,
  "icons": [
    {
      "src": "/app-icon-192.png",
      "type": "image/png",
      "sizes": "192x192"
    },
    {
      "src": "/app-icon.png",
      "type": "image/png",
      "sizes": "512x512"
    },
    {
      "src": "/app-icon-192-maskable.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "maskable"
    }
  ],
  "start_url": "/",
  "display": "standalone",
  "scope": "/",
  "description": "Structured bug tracking and training-data review for ES Windows",
  "categories": ["bugs", "business", "productivity"],
  "shortcuts": [
    {
      "name": "Notifications",
      "description": "Catch up on recent notifications",
      "url": "<%= notifications_path %>",
      "icons": [{ "src": "<%= image_url("bell.svg") %>", "sizes": "any" }]
    },
    {
      "name": "Cactus Home",
      "description": "Open the Cactus workflow dashboard",
      "url": "<%= cactus_home_path %>",
      "icons": [{ "src": "<%= image_url("activity.svg") %>", "sizes": "any" }]
    }
  ]
}
