<%= turbo_frame_tag board, :entropy do %>
  <div class="margin-block-end">
    <h2 class="divider txt-large">Auto close</h2>
    <p class="margin-none-block-start">Cactus can move stale issues to "Not now" if no one updates, comments, or moves an issue for...</p>
    <%= render "entropy/auto_close", model: board, url: board_entropy_path(board), disabled: !Current.user.can_manage_cactus_project?(board) %>
  </div>
<% end %>
