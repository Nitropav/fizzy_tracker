<% @page_title = "Report a bug" %>
<% @body_class = "compact-on-touch" %>

<% content_for :header do %>
  <div class="header__actions header__actions--start">
    <%= link_back_to_board(@board) %>
  </div>

  <h1 class="header__title" data-bridge--title-target="header">
    <span class="overflow-ellipsis"><%= @page_title %></span>
  </h1>
<% end %>

<section class="panel panel--wide center flex flex-column gap txt-align-start">
  <header>
    <h1 class="txt-x-large font-weight-black margin-none">Report a bug</h1>
    <p class="txt-small txt-subtle margin-none">
      Capture the reporter-side details needed before this card can enter the support queue.
    </p>
  </header>

  <% if @resolution_record.errors.any? %>
    <div class="panel txt-small">
      <strong>Check the bug report:</strong>
      <%= @resolution_record.errors.full_messages.to_sentence %>.
    </div>
  <% end %>

  <%= form_with url: board_bug_report_path(@board), scope: :bug_report, class: "flex flex-column gap", data: { controller: "form" } do |form| %>
    <div class="flex flex-column gap-half">
      <%= form.label :title, "Short title", class: "txt-small txt-bold" %>
      <%= form.text_field :title, value: @card.title, class: "input full-width", placeholder: "Example: Checkout total changes after refresh", autofocus: true %>
    </div>

    <div class="flex flex-column gap-half">
      <%= form.label :problem_description, "What is the problem?", class: "txt-small txt-bold" %>
      <%= form.text_area :problem_description, value: @resolution_record.problem_description, rows: 4, required: true, class: "input input--textarea full-width", placeholder: "Describe what is broken, confusing, or not working." %>
    </div>

    <div class="flex flex-column gap-half">
      <%= form.label :reproduction_steps, "How can we reproduce it?", class: "txt-small txt-bold" %>
      <%= form.text_area :reproduction_steps, value: @resolution_record.reproduction_steps, rows: 4, class: "input input--textarea full-width", placeholder: "Step 1...\nStep 2...\nStep 3..." %>
    </div>

    <div class="grid gap" style="grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));">
      <div class="flex flex-column gap-half">
        <%= form.label :expected_behavior, "Expected behavior", class: "txt-small txt-bold" %>
        <%= form.text_area :expected_behavior, value: @resolution_record.expected_behavior, rows: 3, class: "input input--textarea full-width", placeholder: "What should have happened?" %>
      </div>

      <div class="flex flex-column gap-half">
        <%= form.label :actual_behavior, "Actual behavior", class: "txt-small txt-bold" %>
        <%= form.text_area :actual_behavior, value: @resolution_record.actual_behavior, rows: 3, class: "input input--textarea full-width", placeholder: "What actually happened?" %>
      </div>
    </div>

    <div class="flex flex-column gap-half">
      <%= form.label :environment_context, "Environment context", class: "txt-small txt-bold" %>
      <%= form.text_area :environment_context, value: @resolution_record.environment_context, rows: 3, class: "input input--textarea full-width", placeholder: "Product area, UI screen, customer account, browser, device, or relevant data." %>
    </div>

    <div class="flex align-center justify-between gap">
      <%= link_to "Cancel", @board, class: "btn" %>
      <%= form.submit "Create bug report", class: "btn btn--reversed" %>
    </div>
  <% end %>
</section>
