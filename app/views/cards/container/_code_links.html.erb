<% code_links = card.code_links.latest_first %>

<% if code_links.any? %>
  <section id="<%= dom_id(card, :code_links) %>" class="card__code-links panel flex flex-column gap-half margin-block-start">
    <header>
      <h2 class="txt-large margin-none">Code evidence</h2>
      <p class="txt-small txt-subtle margin-none">Commits and pull requests linked automatically from GitHub references like CT-<%= card.number %>.</p>
    </header>

    <%= render "cards/code_links/list", code_links: code_links %>
  </section>
<% end %>
