<% field_class = local_assigns.fetch(:field_class, "input full-width") %>
<% include_labels = local_assigns.fetch(:include_labels, true) %>

<div class="flex flex-column gap-half">
  <% if include_labels %>
    <%= form.label :priority, class: "txt-small txt-bold" %>
  <% end %>
  <%= form.select :priority,
        options_for_select(Card::ResolutionRecord.priority_options(record.priority).map { |value| [ value.humanize, value ] }, record.priority),
        { prompt: "Priority..." },
        class: field_class %>
</div>

